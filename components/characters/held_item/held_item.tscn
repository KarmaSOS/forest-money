[sub_resource type="Shader" id="Shader_jfx34"]
code = "shader_type canvas_item;

uniform bool active = false;
uniform vec4 outline_color : source_color = vec4(1.0, 1.0, 1.0, 1.0); // Warna putih
uniform float outline_width : hint_range(0.0, 10.0) = 1.5; // Ketebalan border

void fragment() {
	vec4 col = texture(TEXTURE, UV);
	
	if (active && col.a == 0.0) {
		vec2 size = TEXTURE_PIXEL_SIZE * outline_width;
		float alpha = 0.0;
		
		// Mengecek 8 arah piksel di sekitar tepi sprite
		alpha += texture(TEXTURE, UV + vec2(0.0, -size.y)).a;
		alpha += texture(TEXTURE, UV + vec2(0.0, size.y)).a;
		alpha += texture(TEXTURE, UV + vec2(-size.x, 0.0)).a;
		alpha += texture(TEXTURE, UV + vec2(size.x, 0.0)).a;
		alpha += texture(TEXTURE, UV + vec2(-size.x, -size.y)).a;
		alpha += texture(TEXTURE, UV + vec2(size.x, -size.y)).a;
		alpha += texture(TEXTURE, UV + vec2(-size.x, size.y)).a;
		alpha += texture(TEXTURE, UV + vec2(size.x, size.y)).a;
		
		if (alpha > 0.0) {
			col = outline_color;
		}
	}
	
	COLOR = col;
}
"

